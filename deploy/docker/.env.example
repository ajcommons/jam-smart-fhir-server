# Copy this file to .env and fill in your values before running docker compose.
# Never commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=smartfhir
DB_USER=smartfhir
DB_PASSWORD=change_me_in_production

# ── Server identity ────────────────────────────────────────────────────────────
# Public HTTPS URL of this auth server — appears in id_token 'iss' claim
# and /.well-known/smart-configuration. Must be HTTPS in production.
ISSUER_URL=https://auth.yourdomain.com

# Base URL of the FHIR server this auth server protects
FHIR_BASE_URL=https://fhir.yourdomain.com/fhir

# ── RSA signing key (JWT signing) ──────────────────────────────────────────────
# Path to the secret file on the Docker host (docker compose maps it as a secret)
SIGNING_KEYSTORE_FILE=./secrets/signing.p12
KEYSTORE_PASSWORD=change_me
KEYSTORE_ALIAS=smart-fhir

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN_1=https://smart-app.yourdomain.com
CORS_ORIGIN_2=

# ── SMART client ───────────────────────────────────────────────────────────────
SMART_CLIENT_LAUNCH_URL=https://smart-app.yourdomain.com/launch
DEFAULT_CLIENT_ID=akhester-smart-client

# ── Embedded TLS — Option B (leave blank / false if using nginx) ───────────────
SSL_ENABLED=false
# SSL_PORT=8443
# TLS_KEYSTORE_FILE=./secrets/server-tls.p12
# SSL_KEYSTORE_PASSWORD=change_me
# SSL_KEY_ALIAS=smart-fhir
