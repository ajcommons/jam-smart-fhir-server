# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in values before running docker-compose
# Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme                       # change this

# ── Auth server ───────────────────────────────────────────────────────────────
ISSUER_URL=http://localhost:9000
FHIR_BASE_URL=http://localhost:8080/fhir
SMART_CLIENT_LAUNCH_URL=http://localhost:8081/launch
DEFAULT_CLIENT_ID=akhester-smart-client

# ── RSA Keystore (leave empty for dev — ephemeral key generated at startup) ──
# For production: generate a PKCS12 keystore (see RsaKeyConfig Javadoc)
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEYSTORE_ALIAS=smart-fhir

# ── SMART client ──────────────────────────────────────────────────────────────
CLIENT_ID=akhester-smart-client
CLIENT_SECRET=                             # empty = public client (PKCE only)
REDIRECT_URI=http://localhost:8081/callback

# ── IdP federation (only needed when SPRING_PROFILES_ACTIVE includes 'idp') ──
# IDP_CLIENT_ID=
# IDP_CLIENT_SECRET=
# IDP_WELLKNOWN_URL=https://your-idp.example.com/.well-known/openid-configuration
# IDP_USER_ID_CLAIM=email
# IDP_USER_LOOKUP_QUERY=http://localhost:8080/fhir/Practitioner?identifier=http://myorg.com/fhir/emp/{identifier}
# IDP_USERNAME_ATTR=email
